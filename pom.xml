<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.0</version>
    <relativePath/>
  </parent>

  <groupId>io.temporal.samples</groupId>
  <artifactId>kafka-consumption</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>kafka-consumption</name>
  <description>Temporal + Kafka consumption reference implementation (see PRD.md)</description>

  <modules>
    <module>common</module>
    <module>order-email-worker</module>
    <module>producer</module>
    <module>consumer-external</module>
    <module>consumer-workflow</module>
    <module>consumer-activity</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <temporal.version>1.31.0</temporal.version>

    <!--
      Docker Engine API version used by Testcontainers.

      docker-java defaults to API v1.32, which recent Docker Desktop releases reject outright with
      HTTP 400 — surfacing as the thoroughly unhelpful "Could not find a valid Docker environment"
      even though the daemon is running and the CLI works. Pinning a modern-but-widely-supported
      version avoids that. 1.43 ships with Docker 24.0 (2023) and newer.

      Override if your daemon is older:  mvn verify -Ddocker.api.version=1.41
    -->
    <docker.api.version>1.43</docker.api.version>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <systemPropertyVariables>
              <api.version>${docker.api.version}</api.version>
            </systemPropertyVariables>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.temporal.samples</groupId>
        <artifactId>common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.temporal</groupId>
        <artifactId>temporal-sdk</artifactId>
        <version>${temporal.version}</version>
      </dependency>
      <dependency>
        <groupId>io.temporal</groupId>
        <artifactId>temporal-spring-boot-starter</artifactId>
        <version>${temporal.version}</version>
      </dependency>
      <dependency>
        <groupId>io.temporal</groupId>
        <artifactId>temporal-testing</artifactId>
        <version>${temporal.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

</project>
